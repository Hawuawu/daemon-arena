{
  "name": "daemon-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Browser robot arena for scripted daemons. Agents write daemon cores, the engine scores them.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "arena": "tsx scripts/arena.ts",
    "coverage": "vitest run --coverage",
    "serve:prod": "npm run build && node scripts/serve-dist.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5"
  }
}
